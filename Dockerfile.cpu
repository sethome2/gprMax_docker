FROM python:3.12-slim-bookworm

ARG GPRMAX_VERSION=4.0.0
ARG GPRMAX_REVISION=116685ebb8d6f68015ea7cda993f1bd7c21f96f1

LABEL org.opencontainers.image.title="gprMax CPU"
LABEL org.opencontainers.image.description="CPU/noGPU Docker image for gprMax"
LABEL org.opencontainers.image.source="https://github.com/sethome2/gprMax_docker"
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"
LABEL org.opencontainers.image.version="${GPRMAX_VERSION}"
LABEL org.opencontainers.image.revision="${GPRMAX_REVISION}"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV OMP_NUM_THREADS=1
ENV GPRMAX_HOME=/opt/gprMax
ENV GPRMAX_PYTHON=python3

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libgomp1 \
        libhdf5-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN ${GPRMAX_PYTHON} -m pip install --upgrade pip setuptools wheel \
    && ${GPRMAX_PYTHON} -c 'import sys; assert (3, 11) <= sys.version_info[:2] < (3, 14), sys.version'

RUN mkdir -p "${GPRMAX_HOME}" \
    && curl -fsSL "https://github.com/gprMax/gprMax/archive/${GPRMAX_REVISION}.tar.gz" -o /tmp/gprmax.tar.gz \
    && tar -xzf /tmp/gprmax.tar.gz --strip-components=1 -C "${GPRMAX_HOME}" \
    && rm /tmp/gprmax.tar.gz

WORKDIR ${GPRMAX_HOME}

RUN ${GPRMAX_PYTHON} -m pip install . \
    && cd /tmp \
    && ${GPRMAX_PYTHON} -c 'import gprMax; assert gprMax.__version__ == "4.0.0", gprMax.__version__'

ENV MPLCONFIGDIR=/tmp/matplotlib

COPY scripts/gprmax-entrypoint.sh /usr/local/bin/gprmax-entrypoint
RUN chmod +x /usr/local/bin/gprmax-entrypoint \
    && mkdir -p /work \
    && for resource in user_models tools user_libs examples toolboxes; do \
        if [ -e "${GPRMAX_HOME}/${resource}" ]; then \
            ln -s "${GPRMAX_HOME}/${resource}" "/work/${resource}"; \
        fi; \
    done

WORKDIR /work

ENTRYPOINT ["gprmax-entrypoint"]
CMD ["--help"]
