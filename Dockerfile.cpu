FROM python:3.13-slim-bookworm

ARG GPRMAX_VERSION=3.1.7
ARG GPRMAX_TAG=v.3.1.7
ARG GPRMAX_CHANNEL=release

LABEL org.opencontainers.image.title="gprMax CPU"
LABEL org.opencontainers.image.description="CPU/noGPU Docker image for gprMax"
LABEL org.opencontainers.image.source="https://github.com/sethome2/gprMax_docker"
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"
LABEL org.opencontainers.image.version="${GPRMAX_VERSION}"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV OMP_NUM_THREADS=1
ENV GPRMAX_HOME=/opt/gprMax
ENV GPRMAX_PYTHON=python3

RUN case "${GPRMAX_CHANNEL}" in release|devel) ;; *) echo "Unsupported GPRMAX_CHANNEL: ${GPRMAX_CHANNEL}" >&2; exit 1 ;; esac \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libgomp1 \
        libhdf5-dev \
        pkg-config \
    && if [ "${GPRMAX_CHANNEL}" = "devel" ]; then \
        apt-get install -y --no-install-recommends libopenmpi-dev openmpi-bin; \
    fi \
    && rm -rf /var/lib/apt/lists/*

RUN ${GPRMAX_PYTHON} -m pip install --upgrade pip setuptools wheel \
    && ${GPRMAX_PYTHON} -c 'import sys; assert (3, 11) <= sys.version_info[:2] < (3, 14), sys.version'

RUN mkdir -p "${GPRMAX_HOME}" \
    && curl -fsSL "https://github.com/gprMax/gprMax/archive/${GPRMAX_TAG}.tar.gz" -o /tmp/gprmax.tar.gz \
    && tar -xzf /tmp/gprmax.tar.gz --strip-components=1 -C "${GPRMAX_HOME}" \
    && rm /tmp/gprmax.tar.gz

WORKDIR ${GPRMAX_HOME}

RUN ${GPRMAX_PYTHON} -m pip install \
        colorama \
        cython \
        h5py \
        jupyter \
        matplotlib \
        numpy \
        psutil \
        scipy \
        terminaltables \
        tqdm \
    && if [ "${GPRMAX_CHANNEL}" = "devel" ]; then \
        ${GPRMAX_PYTHON} -m pip install \
            humanize \
            jinja2 \
            mpi4py \
            numpy-stl \
            typing-extensions; \
    fi \
    && ${GPRMAX_PYTHON} setup.py build \
    && ${GPRMAX_PYTHON} setup.py install \
    && ${GPRMAX_PYTHON} setup.py clean

COPY scripts/gprmax-entrypoint.sh /usr/local/bin/gprmax-entrypoint
RUN chmod +x /usr/local/bin/gprmax-entrypoint \
    && mkdir -p /work \
    && for resource in user_models tools user_libs examples toolboxes; do \
        if [ -e "${GPRMAX_HOME}/${resource}" ]; then \
            ln -s "${GPRMAX_HOME}/${resource}" "/work/${resource}"; \
        fi; \
    done

WORKDIR /work

ENTRYPOINT ["gprmax-entrypoint"]
CMD ["--help"]
