ARG CUDA_VERSION=12.6.3
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04

ARG GPRMAX_VERSION=4.0.1
ARG GPRMAX_REVISION=3ab1c854348a9220beed6ff6925b166a14cfe2b4
ARG GPRMAX_CHANNEL=v4
ARG PACKAGING_REVISION=local
ARG CUDA_VERSION

LABEL org.opencontainers.image.title="gprMax GPU"
LABEL org.opencontainers.image.description="NVIDIA GPU Docker image for gprMax"
LABEL org.opencontainers.image.source="https://github.com/sethome2/gprMax_docker"
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"
LABEL org.opencontainers.image.version="${GPRMAX_VERSION}"
LABEL org.opencontainers.image.revision="${GPRMAX_REVISION}"
LABEL io.gprmax.channel="${GPRMAX_CHANNEL}"
LABEL io.gprmax.packaging-revision="${PACKAGING_REVISION}"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV OMP_NUM_THREADS=1
ENV GPRMAX_BUILD_JOBS=2
ENV GPRMAX_VERSION=${GPRMAX_VERSION}
ENV GPRMAX_VARIANT=gpu
ENV CC=/usr/local/bin/portable-cc
ENV GPRMAX_HOME=/opt/gprMax
ENV CUDA_HOME=/usr/local/cuda
ENV GPRMAX_VENV=/opt/gprmax-venv
ENV GPRMAX_PYTHON=/opt/gprmax-venv/bin/python
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"
ENV PATH="${GPRMAX_VENV}/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libgomp1 \
        libhdf5-dev \
        pkg-config \
        python3 \
        python3-dev \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv "${GPRMAX_VENV}" \
    && "${GPRMAX_PYTHON}" -m pip install --upgrade pip setuptools wheel \
    && "${GPRMAX_PYTHON}" -c 'import sys; assert (3, 11) <= sys.version_info[:2] < (3, 14), sys.version'

RUN mkdir -p "${GPRMAX_HOME}" \
    && curl -fsSL "https://github.com/gprMax/gprMax/archive/${GPRMAX_REVISION}.tar.gz" -o /tmp/gprmax.tar.gz \
    && tar -xzf /tmp/gprmax.tar.gz --strip-components=1 -C "${GPRMAX_HOME}" \
    && rm /tmp/gprmax.tar.gz

WORKDIR ${GPRMAX_HOME}

COPY scripts/install.sh scripts/source_manifest.py /usr/local/libexec/
COPY scripts/portable-cc /usr/local/bin/portable-cc
RUN chmod +x /usr/local/bin/portable-cc \
    && sh /usr/local/libexec/install.sh

ENV MPLCONFIGDIR=/tmp/matplotlib

COPY scripts/gprmax-entrypoint.sh /usr/local/bin/gprmax-entrypoint
RUN chmod +x /usr/local/bin/gprmax-entrypoint \
    && mkdir -p /work \
    && for resource in user_models tools user_libs examples toolboxes; do \
        if [ -e "${GPRMAX_HOME}/${resource}" ]; then \
            ln -s "${GPRMAX_HOME}/${resource}" "/work/${resource}"; \
        fi; \
    done

WORKDIR /work

ENTRYPOINT ["gprmax-entrypoint"]
CMD ["--help"]
